# Supabase project URL, e.g. https://xyzcompany.supabase.co (Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable key (sb_publishable_...), from Project Settings > API Keys.
# Never put the secret key (sb_secret_...) or legacy service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public URL this app is deployed at, used for building auth redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth Web client ID (public, not a secret) used by Google Identity
# Services for "Sign in with Google" on our own page (setup.md §4, §7-8).
# The same ID must already be listed in Supabase's Google provider "Client
# IDs". If unset, sign-in falls back to the Supabase-redirect Google flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Delivery (email-delivery change): the app's own Gmail SMTP account for
# sending turn notices and calendar invites, distinct from Supabase Auth's
# own custom SMTP credentials (setup.md documents creating a separate Gmail
# app password). Server-only — never NEXT_PUBLIC_, read only inside
# src/delivery/mailer-smtp.ts.
DELIVERY_SMTP_USER=
DELIVERY_SMTP_APP_PASSWORD=
DELIVERY_FROM_ADDRESS=
# Delivery worker secret (security fix): shared secret the app's own
# server-side delivery-retry code presents to
# claim_pending_dispatches/record_dispatch_outcome, on top of auth.uid(), so
# no other signed-in identity can read queued recipient addresses or
# claim/suppress deliveries. Server-only — never NEXT_PUBLIC_, read only
# inside src/delivery/worker-secret.ts. Its sha256 hash (hex-encoded) must
# also be inserted into app_private.delivery_worker once — see
# docs/stayover/general/setup.md.
DELIVERY_WORKER_SECRET=
