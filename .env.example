# Supabase project URL, e.g. https://xyzcompany.supabase.co (Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable key (sb_publishable_...), from Project Settings > API Keys.
# Never put the secret key (sb_secret_...) or legacy service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public URL this app is deployed at, used for building auth redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
