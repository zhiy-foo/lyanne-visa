# Copy this file to .env.local and fill in your own values.
# Step-by-step instructions for every value: docs/stayover/general/setup.md

# Supabase project URL (Supabase dashboard > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Supabase publishable key (sb_publishable_...), from Project Settings > API Keys.
# Never put the secret key (sb_secret_...) or legacy service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
# Public URL this app is deployed at, used for building auth redirect links
# (http://localhost:3000 locally; your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth Web client ID (public, not a secret) used by Google Identity
# Services for "Sign in with Google" on our own page (setup.md §4, §7-8).
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# The same ID must already be listed in Supabase's Google provider "Client
# IDs". If unset, sign-in falls back to the Supabase-redirect Google flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<numbers>-<random>.apps.googleusercontent.com
# Delivery (email-delivery change): the app's own Gmail SMTP account for
# sending turn notices and calendar invites, distinct from Supabase Auth's
# own custom SMTP credentials (setup.md step 1 documents creating a separate
# Gmail app password named "Delivery"). Server-only — never NEXT_PUBLIC_,
# read only inside src/delivery/mailer-smtp.ts.
# Optional locally: without them, notices just log to the console.
DELIVERY_SMTP_USER=<your-app-gmail>@gmail.com
DELIVERY_SMTP_APP_PASSWORD=<16-character Gmail app password, no spaces>
DELIVERY_FROM_ADDRESS=<your-app-gmail>@gmail.com
# Delivery worker secret: shared secret the app's own server-side
# delivery-retry code presents to claim_pending_dispatches/
# record_dispatch_outcome, on top of auth.uid(). Generate one with
# `openssl rand -hex 32` (64 hex characters). Server-only — never
# NEXT_PUBLIC_, read only inside src/delivery/worker-secret.ts. Its sha256
# hash (hex-encoded) must also be inserted into app_private.delivery_worker
# once — see docs/stayover/general/setup.md step 6.
DELIVERY_WORKER_SECRET=<64 hex characters from openssl rand -hex 32>
# Keepalive cron secret: protects GET /api/keepalive, which Vercel Cron calls
# daily (vercel.json) so the free Supabase project does not pause. Generate one
# with `openssl rand -hex 32`. Server-only — never NEXT_PUBLIC_, read only in
# src/app/api/keepalive/route.ts. Vercel sends it automatically as the Bearer
# token on cron calls once set in the project env vars. If unset, the
# endpoint refuses every call (401).
CRON_SECRET=<64 hex characters from openssl rand -hex 32>
